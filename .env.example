# ==============================================================================
# WRITEORA AI CONTENT GENERATION SYSTEM — PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development or configure these variables
# directly in your Vercel Project Settings (Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SAFE VARIABLES (Exposed to browser bundle via NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Public Anonymous API Key (safe for client use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Production Base Application URL (e.g. https://writeora.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (STRICTLY PRIVATE — NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# OpenRouter API Secret Key for AI Model Generation & Streaming
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Service Role Secret Key (Bypasses RLS - Server Only, Never expose!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# ------------------------------------------------------------------------------
# 3. OPTIONAL SERVER RATE LIMITING & TIER QUOTA CONTROLS
# ------------------------------------------------------------------------------
RATE_LIMIT_GENERATE_PER_MINUTE=5
RATE_LIMIT_SEO_PER_MINUTE=10
DAILY_AI_REQUEST_LIMIT=50
MONTHLY_AI_REQUEST_LIMIT=500
MAX_OUTPUT_TOKENS=4000
